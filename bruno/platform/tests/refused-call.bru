meta {
  name: refused call
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/anything
  body: none
  auth: none
}

tests {
  test("a call without the company context is refused with a 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("the refusal is problem+json", function () {
    expect(String(res.getHeader("content-type")).toLowerCase().startsWith("application/problem+json")).to.equal(true);
  });

  test("the body has a status, a title and a code", function () {
    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.title).to.be.a("string").that.is.not.empty;
    expect(body.code).to.be.a("string").that.is.not.empty;
  });

  test("the body holds no secret and no stack trace", function () {
    const text = JSON.stringify(res.getBody());
    expect(/password|secret|token|authorization|api_key/i.test(text)).to.equal(false);
    expect(text.includes("Traceback")).to.equal(false);
  });
}
