# Settings of the laptop profile, read by check-machine.sh and by the other scripts of this folder.
# Memory budget of the laptop profile in MiB: the 8 GB laptop of D408 (d408-performance-and-profiles.md).
MEMORY_MIN_MIB=8192
# Cores needed: "4 cores at normal load" (docs/technical/infrastructure/performance-and-capacity.md).
CPUS_MIN=4
# Free disk needed in GiB: a plan assumption of T0.25, because the specifications give no disk size.
DISK_FREE_MIN_GIB=20
# Seconds of rest before the memory is measured (plan assumption of T0.25).
REST_S=60
# Compose file of T0.21 that the laptop overlay is laid over, relative to infra/compose/.
BASE_COMPOSE_FILE=compose.yaml
# Compose file of the laptop profile delivered by T0.21 (REQ-T09-02), relative to infra/compose/. It is laid over compose.yaml.
LAPTOP_COMPOSE_FILE=compose.laptop.yaml
