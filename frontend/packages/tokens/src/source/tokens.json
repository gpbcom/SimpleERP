{
  "colors": {
    "primary": { "light": "#4B4FC9", "dark": "#A3A6FF" },
    "accent": { "light": "#F2B134", "dark": "#F2B134" },
    "success": { "light": "#2E7D32", "dark": "#7BC67E" },
    "error": { "light": "#C62828", "dark": "#FF8A80" },
    "warning": { "light": "#8A5A00", "dark": "#F2C46D" },
    "text": { "light": "#1C1F24", "dark": "#ECEDF3" },
    "text-muted": { "light": "#5B6170", "dark": "#A6AABA" },
    "surface": { "light": "#FFFFFF", "dark": "#14151C" },
    "surface-alt": { "light": "#F5F5FB", "dark": "#1E2029" },
    "border": { "light": "#D9DAE6", "dark": "#343747" },
    "border-strong": { "light": "#7A7F92", "dark": "#7C8096" },
    "surface-raised-1": { "light": "#FFFFFF", "dark": "#1E2029" },
    "surface-raised-2": { "light": "#FFFFFF", "dark": "#282A36" }
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48],
  "density": {
    "row-height": { "comfortable": 48, "compact": 32 },
    "cell-padding": { "comfortable": 12, "compact": 6 },
    "field-height": { "comfortable": 44, "compact": 32 },
    "body-size": { "comfortable": 16, "compact": 14 }
  },
  "typography": {
    "families": {
      "heading": "\"Plus Jakarta Sans\", sans-serif",
      "body": "\"Inter\", sans-serif",
      "code": "\"JetBrains Mono\", monospace"
    },
    "styles": {
      "display": { "family": "heading", "sizePx": 40, "lineHeightPx": 48, "weight": 800 },
      "h1": { "family": "heading", "sizePx": 32, "lineHeightPx": 40, "weight": 700 },
      "h2": { "family": "heading", "sizePx": 24, "lineHeightPx": 32, "weight": 700 },
      "h3": { "family": "heading", "sizePx": 20, "lineHeightPx": 28, "weight": 600 },
      "body": { "family": "body", "sizePx": 16, "lineHeightPx": 24, "weight": 400 },
      "body-compact": { "family": "body", "sizePx": 14, "lineHeightPx": 20, "weight": 400 },
      "label": { "family": "body", "sizePx": 14, "lineHeightPx": 20, "weight": 500 },
      "caption": { "family": "body", "sizePx": 12, "lineHeightPx": 16, "weight": 400 },
      "code": { "family": "code", "sizePx": 14, "lineHeightPx": 20, "weight": 400 }
    }
  },
  "radius": { "card": "8px", "field": "8px", "panel": "12px", "badge": "9999px" },
  "elevation": {
    "1": {
      "light": "0 1px 2px rgba(28,31,36,.06), 0 2px 6px rgba(28,31,36,.08)",
      "dark": "none"
    },
    "2": {
      "light": "0 8px 24px rgba(28,31,36,.14), 0 24px 56px rgba(28,31,36,.16)",
      "dark": "none"
    }
  },
  "fonts": [
    { "family": "Inter", "weight": 400, "file": "inter-latin-400-normal.woff2", "package": "@fontsource/inter" },
    { "family": "Inter", "weight": 500, "file": "inter-latin-500-normal.woff2", "package": "@fontsource/inter" },
    { "family": "Inter", "weight": 600, "file": "inter-latin-600-normal.woff2", "package": "@fontsource/inter" },
    { "family": "Plus Jakarta Sans", "weight": 600, "file": "plus-jakarta-sans-latin-600-normal.woff2", "package": "@fontsource/plus-jakarta-sans" },
    { "family": "Plus Jakarta Sans", "weight": 700, "file": "plus-jakarta-sans-latin-700-normal.woff2", "package": "@fontsource/plus-jakarta-sans" },
    { "family": "Plus Jakarta Sans", "weight": 800, "file": "plus-jakarta-sans-latin-800-normal.woff2", "package": "@fontsource/plus-jakarta-sans" },
    { "family": "JetBrains Mono", "weight": 400, "file": "jetbrains-mono-latin-400-normal.woff2", "package": "@fontsource/jetbrains-mono" }
  ]
}
