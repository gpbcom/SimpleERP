  },
  "devDependencies": {
    "@simpleerp/config": "workspace:*",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/user-event": "14.6.13",
    "@testing-library/vue": "8.1.0",
    "@types/node": "22.20.7",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "axe-core": "4.14.1",
    "eslint": "10.16.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.34",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "vue": "3.5.46",
    "vue-tsc": "3.3.14"
  }
