{
  "name": "@simpleerp/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/ui.js"
    },
    "./style.css": "./dist/ui.css"
  },
  "scripts": {
