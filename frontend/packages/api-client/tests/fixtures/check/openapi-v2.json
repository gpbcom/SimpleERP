{
  "openapi": "3.1.0",
  "info": { "title": "Items", "version": "1.0.0" },
  "paths": {
    "/v1/items": {
      "get": {
        "operationId": "listItems",
        "responses": {
          "200": {
            "description": "The item.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["name"],
                  "properties": { "name": { "type": "string" }, "price": { "type": "number" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
