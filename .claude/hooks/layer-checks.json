{
  "max_blocks": 2,
  "rules": [
    {
      "name": "ruff check",
      "match": "^(?:backend|plugins|sdk|tests|\\.claude)/.+\\.py$",
      "run": [
        "uv",
        "run",
        "ruff",
        "check",
        "{files}"
      ]
    },
    {
      "name": "ruff format",
      "match": "^(?:backend|plugins|sdk|tests|\\.claude)/.+\\.py$",
      "run": [
        "uv",
        "run",
        "ruff",
        "format",
        "--check",
        "{files}"
      ]
    },
    {
      "name": "mypy {1}",
      "match": "^(backend/models|backend/shared/[^/]+|backend/services/[^/]+|plugins/[^/]+|sdk)/src/.+\\.py$",
      "run": [
        "uv",
        "run",
        "mypy",
        "{1}/src"
      ]
    },
    {
      "name": "pytest {1}/tests/{2}",
      "match": "^(backend/models|backend/shared/[^/]+|backend/services/[^/]+|plugins/[^/]+|sdk)/src/[^/]+/(.+)/[^/]+\\.py$",
      "run": [
        "uv",
        "run",
        "pytest",
        "{1}/tests/{2}",
        "-n",
        "2"
      ],
      "needs": "{1}/tests/{2}",
      "skip_when_only_tests": true
    },
    {
      "name": "pytest harness {1}",
      "match": "^\\.claude/(?:hooks|scripts(?:/[^/]+)?|skills/[^/]+/scripts)/([^/]+)\\.py$",
      "run": [
        "uv",
        "run",
        "pytest",
        "tests/harness/{1}",
        "-n",
        "2"
      ],
      "needs": "tests/harness/{1}",
      "skip_when_only_tests": true
    },
    {
      "name": "pnpm lint {1}",
      "match": "^(frontend/(?:portals/|packages/)?[^/]+)/",
      "run": [
        "pnpm",
        "--filter",
        "./{1}",
        "run",
        "--if-present",
        "lint"
      ],
      "needs": "{1}/package.json"
    },
    {
      "name": "pnpm typecheck {1}",
      "match": "^(frontend/(?:portals/|packages/)?[^/]+)/",
      "run": [
        "pnpm",
        "--filter",
        "./{1}",
        "run",
        "--if-present",
        "typecheck"
      ],
      "needs": "{1}/package.json"
    },
    {
      "name": "pnpm test {1}",
      "match": "^(frontend/(?:portals/|packages/)?[^/]+)/",
      "run": [
        "pnpm",
        "--filter",
        "./{1}",
        "run",
        "--if-present",
        "test"
      ],
      "needs": "{1}/package.json",
      "skip_when_only_tests": true
    },
    {
      "name": "terraform fmt {1}",
      "match": "^(infra/terraform/.+?)(?:/tests)?/[^/]+\\.(?:tf|tftest\\.hcl)$",
      "run": [
        "terraform",
        "fmt",
        "-check",
        "-recursive",
        "{1}"
      ]
    },
    {
      "name": "terraform init {1}",
      "match": "^(infra/terraform/.+?)(?:/tests)?/[^/]+\\.(?:tf|tftest\\.hcl)$",
      "run": [
        "terraform",
        "-chdir={1}",
        "init",
        "-backend=false",
        "-input=false"
      ],
      "skip_when_only_tests": true
    },
    {
      "name": "terraform validate {1}",
      "match": "^(infra/terraform/.+?)(?:/tests)?/[^/]+\\.(?:tf|tftest\\.hcl)$",
      "run": [
        "terraform",
        "-chdir={1}",
        "validate"
      ],
      "skip_when_only_tests": true
    },
    {
      "name": "terraform test {1}",
      "match": "^(infra/terraform/.+?)(?:/tests)?/[^/]+\\.(?:tf|tftest\\.hcl)$",
      "run": [
        "terraform",
        "-chdir={1}",
        "test"
      ],
      "needs": "{1}/tests",
      "skip_when_only_tests": true
    },
    {
      "name": "check_ticket {1}",
      "match": "^docs/tickets/(T\\d{1,2}\\.\\d{2})/TICKET\\.md$",
      "run": [
        "python3",
        ".claude/skills/ticket/scripts/check_ticket.py",
        "{1}"
      ]
    },
    {
      "name": "check_plan {1}",
      "match": "^docs/tickets/(T\\d{1,2}\\.\\d{2})/PLAN\\.md$",
      "run": [
        "python3",
        ".claude/skills/ticket/scripts/check_plan.py",
        "{1}"
      ]
    }
  ]
}
